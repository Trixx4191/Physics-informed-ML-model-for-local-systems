map_hash_bucket_size 128;
limit_req_zone $binary_remote_addr zone=pinn_requests:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=pinn_callbacks:10m rate=3r/s;
map $http_x_pinn_origin $pinn_origin_allowed {
    default 0;
    "__PINN_ORIGIN_TOKEN__" 1;
}

server {
    listen 80 default_server;
    server_name _;
    server_tokens off;
    client_max_body_size 2m;
    limit_req_status 429;

    if ($pinn_origin_allowed = 0) { return 403; }

    location = /_dash-update-component {
        limit_req zone=pinn_callbacks burst=12 nodelay;
        add_header Cache-Control "no-store" always;
        proxy_pass http://127.0.0.1:8050;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_read_timeout 300s;
        proxy_buffering off;
    }

    location / {
        limit_req zone=pinn_requests burst=100 nodelay;
        proxy_pass http://127.0.0.1:8050;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_read_timeout 300s;
    }
}
