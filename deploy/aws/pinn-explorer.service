[Unit]
Description=PINN Multi-Physics Explorer Dash application
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=pinn
Group=pinn
WorkingDirectory=/opt/pinn-explorer/current
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=DASH_DEBUG=0
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1
Environment=MPLCONFIGDIR=/var/cache/pinn-explorer/matplotlib
Environment=XDG_CACHE_HOME=/var/cache/pinn-explorer
Environment=DASH_CACHE_DIR=/var/cache/pinn-explorer/dash
EnvironmentFile=-/etc/pinn-explorer/pinn.env
CacheDirectory=pinn-explorer
CacheDirectoryMode=0750
ExecStart=/opt/pinn-explorer/venv/bin/gunicorn --config /etc/pinn-explorer/gunicorn.conf.py dash_app.app:server
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
OOMPolicy=stop
MemoryHigh=2500M
MemoryMax=3G
CPUQuota=175%
TasksMax=256
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/cache/pinn-explorer

[Install]
WantedBy=multi-user.target
